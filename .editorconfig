root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_style = space
indent_size = 4
max_line_length = 140
ktlint_code_style = android_studio
# Multi-line lists end with a comma, so adding an entry changes one line.
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
# Composable functions are named like the things they draw, with a capital first letter.
ktlint_function_naming_ignore_when_annotated_with = Composable
