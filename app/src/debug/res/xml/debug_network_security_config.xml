<?xml version="1.0" encoding="utf-8"?>
<!-- Plain HTTP stays blocked everywhere except the device's own loopback address, where a debug
     build reaches `wrangler dev` through `adb reverse` and the instrumented tests run a local
     stand-in for the AI proxy. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
