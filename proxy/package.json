{
  "name": "split-vibe-proxy",
  "private": true,
  "license": "SEE LICENSE IN ../LICENSE",
  "type": "module",
  "scripts": {
    "build:web": "npm --prefix ../web run build && node scripts/embed-web.mjs",
    "bundle": "node scripts/bundle.mjs",
    "test": "node scripts/embed-web.mjs && vitest run && node --test eval/shared/test/proxy-process.test.mjs eval/shared/test/no-key.test.mjs scripts/test/metrics.test.mjs scripts/test/embed-web.test.mjs",
    "typecheck": "node scripts/embed-web.mjs && wrangler types --strict-vars=false && tsc",
    "dev": "node scripts/embed-web.mjs && wrangler dev",
    "eval:revise": "node eval/revise/run.mjs",
    "eval:read": "node eval/read/run.mjs",
    "metrics": "node scripts/metrics.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.8.5",
    "@msw/cloudflare": "0.2.0",
    "msw": "3.0.5",
    "typescript": "5.9.3",
    "vitest": "5.1.0",
    "wrangler": "4.162.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.8.0",
    "jose": "6.2.17"
  }
}
