{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "split-vibe-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "upload_source_maps": true,
  // Logs hold only what the Worker prints, which is never a bill, a name, an install id or an IP.
  // Invocation logs are off because they record every request's headers, the session and the IP
  // among them. Traces record timings, the outcome, CPU time, rough location, the user agent and
  // the URL, but no header values, no IP and no body, so they stay on: URLs hold ids only, never
  // a link's token, which travels in the link's fragment and in request bodies.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false },
    "traces": { "enabled": true }
  },
  // Switches and public settings. GOOGLE_CLIENT_ID is the app's web client ID at Google; sign-in
  // stays off until it is set. ANDROID_CERT_SHA256 lists the SHA-256 fingerprints of the keys that
  // sign the release app, the upload key and Play's app signing key, comma-separated, for its App
  // Links; ANDROID_DEV_CERT_SHA256 those of the debug key, for the debug app's, set only on a Worker
  // that debug builds use and left empty here, so that no app signed with a debug key opens the
  // production links. Both are public. TURNSTILE_SITE_KEY is the site key of the Turnstile widget
  // the web pages show before a new claim, and ABUSE_EMAIL the address of their "Report abuse"
  // link, left out while it is empty; both are public. Secrets
  // (ANTHROPIC_API_KEY, HASH_SALT, SESSION_SIGNING_KEY and the optional FCM_SERVICE_ACCOUNT,
  // TURNSTILE_SECRET, REVENUECAT_SECRET_KEY and REVENUECAT_WEBHOOK_AUTH) are set with
  // `wrangler secret put` and never written here.
  "vars": {
    "AI_ENABLED": "true",
    "MIN_APP_VERSION": "1",
    "GOOGLE_CLIENT_ID": "",
    "ANDROID_CERT_SHA256": "",
    "ANDROID_DEV_CERT_SHA256": "",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAGB-qh7Zte4I2dnY",
    "ABUSE_EMAIL": ""
  },
  // The exchange rates are fetched every day at 16:30 UTC, once the European Central Bank has
  // published its rates of the day, and also by the first request that finds them a day old. The
  // same run sends the payment reminders that are due, forgets expired invites, and deletes bill
  // links that expired or were revoked.
  "triggers": {
    "crons": ["30 16 * * *"]
  },
  // Groups, their bills and settlements, payment requests, devices and bill links. Apply the
  // migrations in migrations_dir before a deploy that needs them:
  // `wrangler d1 migrations apply split-vibe --remote`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "split-vibe",
      "database_id": "aa4b8b73-86ad-410d-8205-fd7640808b56",
      "migrations_dir": "migrations"
    }
  ],
  // What the proxy counts: each data point an event, its outcome and numbers, never an account,
  // an install id, an IP or any id. The dataset is made at the first write; without the binding
  // nothing is counted. `npm run metrics` reads the counts back.
  "analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "split_vibe_events" }],
  "durable_objects": {
    "bindings": [
      { "name": "QUOTA_BOOK", "class_name": "QuotaBook" },
      { "name": "ABUSE_LEDGER", "class_name": "AbuseLedger" },
      { "name": "FX_BOOK", "class_name": "FxBook" },
      // The live connections of each bill link's page; they hold no data.
      { "name": "SHARE_ROOM", "class_name": "ShareRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["QuotaBook", "AbuseLedger"] },
    { "tag": "v2", "new_sqlite_classes": ["FxBook"] },
    { "tag": "v3", "new_sqlite_classes": ["ShareRoom"] }
  ]
}
