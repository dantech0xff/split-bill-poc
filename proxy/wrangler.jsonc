{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "split-vibe-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "upload_source_maps": true,
  // Logs hold only what the Worker prints, which is never a bill, a name, an install id or an IP.
  // Invocation logs are off because they record every request's headers, the session and the IP
  // among them. Traces record timings, the outcome, CPU time, rough location and the user agent,
  // but no header values, no IP and no body, so they stay on.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false },
    "traces": { "enabled": true }
  },
  // Switches and public settings. GOOGLE_CLIENT_ID is the app's web client ID at Google; sign-in
  // stays off until it is set. ANDROID_CERT_SHA256 lists the SHA-256 fingerprints of the keys that
  // sign the app, comma-separated, for App Links; it is public too. Secrets (ANTHROPIC_API_KEY,
  // HASH_SALT, SESSION_SIGNING_KEY and the optional FCM_SERVICE_ACCOUNT) are set with
  // `wrangler secret put` and never written here.
  "vars": {
    "AI_ENABLED": "true",
    "MIN_APP_VERSION": "1",
    "GOOGLE_CLIENT_ID": "",
    "ANDROID_CERT_SHA256": ""
  },
  // The exchange rates are fetched every day at 16:30 UTC, once the European Central Bank has
  // published its rates of the day, and also by the first request that finds them a day old. The
  // same run sends the payment reminders that are due and forgets expired invites.
  "triggers": {
    "crons": ["30 16 * * *"]
  },
  // Groups, their bills and settlements, payment requests and devices. Apply the migrations in
  // migrations_dir before a deploy that needs them: `wrangler d1 migrations apply split-vibe --remote`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "split-vibe",
      "database_id": "aa4b8b73-86ad-410d-8205-fd7640808b56",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "QUOTA_BOOK", "class_name": "QuotaBook" },
      { "name": "ABUSE_LEDGER", "class_name": "AbuseLedger" },
      { "name": "FX_BOOK", "class_name": "FxBook" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["QuotaBook", "AbuseLedger"] },
    { "tag": "v2", "new_sqlite_classes": ["FxBook"] }
  ]
}
