{
  "name": "split-vibe-web",
  "private": true,
  "license": "SEE LICENSE IN ../LICENSE",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && node scripts/static-pages.mjs && node scripts/verify-build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "size": "node scripts/size.mjs",
    "e2e": "playwright test"
  },
  "dependencies": {
    "lean-qr": "2.7.4",
    "preact": "11.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@preact/preset-vite": "2.10.6",
    "@types/node": "22.20.5",
    "happy-dom": "21.0.4",
    "marked": "18.2.1",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
